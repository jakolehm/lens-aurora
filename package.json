{
  "name": "@jakolehm/lens-aurora",
  "version": "0.1.0",
  "description": "A live 3D view of every Kubernetes cluster Lens is connected to.",
  "keywords": [
    "lens-extension"
  ],
  "license": "Apache-2.0",
  "author": "jkolehmainen@mirantis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakolehm/lens-aurora.git"
  },
  "bugs": {
    "url": "https://github.com/jakolehm/lens-aurora/issues"
  },
  "homepage": "https://github.com/jakolehm/lens-aurora#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@k8slens/cluster-contracts": "^2.2.0",
    "@k8slens/command-palette-contracts": "^1.0.2",
    "@k8slens/element-components": "^3.9.0",
    "@k8slens/feature-core": "^7.5.2",
    "@k8slens/icon": "^4.0.0",
    "@k8slens/injectable": "^26.2.1",
    "@k8slens/kubernetes-contracts": "^2.0.2",
    "@k8slens/main-view-contracts": "^1.3.2",
    "@k8slens/messaging-contracts": "^1.0.0",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/sub-window-contracts": "^1.0.0",
    "@k8slens/subscribable": "^1.1.3",
    "@k8slens/tab-contracts": "^1.2.0",
    "@k8slens/top-bar-contracts": "^1.0.2",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/three": "^0.185.4",
    "rimraf": "^4.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
